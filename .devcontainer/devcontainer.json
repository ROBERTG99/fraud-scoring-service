{
  "name": "fraud-scoring-service",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "make bootstrap",
  "forwardPorts": [8500, 8510, 8511, 8513, 8514, 8515, 8560],
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "charliermarsh.ruff", "ms-python.python", "dbaeumer.vscode-eslint", "hashicorp.terraform"]
    }
  }
}
