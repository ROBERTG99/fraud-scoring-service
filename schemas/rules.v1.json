{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraud-scoring-service.local/schemas/rules.v1.json",
  "title": "fraud.rules.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "feature_spec", "thresholds", "degraded", "model_reason_codes", "rules"],
  "properties": {
    "schema": { "const": "fraud.rules.v1" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,3}$" },
    "feature_spec": { "enum": ["v1", "v2"] },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "decline"],
      "properties": {
        "review": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "decline": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "degraded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_unavailable", "features_unavailable"],
      "properties": {
        "model_unavailable": { "$ref": "#/$defs/degradedBand" },
        "features_unavailable": { "$ref": "#/$defs/degradedBand" }
      }
    },
    "model_reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min_score", "code"],
        "properties": {
          "min_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "code": { "$ref": "#/$defs/reasonCode" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "when", "action", "reason_code"],
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d{3}$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "when": { "type": "string", "minLength": 1, "maxLength": 500 },
          "action": { "enum": ["APPROVE", "REVIEW", "DECLINE"] },
          "reason_code": { "$ref": "#/$defs/reasonCode" },
          "final": { "type": "boolean" },
          "description": { "type": "string", "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "degradedBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_min_amount_minor"],
      "properties": { "review_min_amount_minor": { "type": "integer", "minimum": 1 } }
    }
  }
}
