# Copy to .env (make bootstrap does this). Every variable is optional for offline runs.
# Never put real secrets in this file; .env is git-ignored.

# --- compose builds: host in a cloud sandbox, default elsewhere
COMPOSE_BUILD_NETWORK=default

# --- scorer (Go) --------------------------------------------------------
FRAUD_SERVICE_TOKEN=dev-service-token-change-me
FRAUD_GRPC_ADDR=:8510
FRAUD_HTTP_ADDR=:8511
FRAUD_REDIS_ADDR=redis:6379
FRAUD_REDIS_PREFIX=fr
FRAUD_PG_DSN=postgres://fraud_app:fraud_app@postgres:5432/fraud?sslmode=disable
FRAUD_PG_MIGRATE_DSN=postgres://fraud:fraud@postgres:5432/fraud?sslmode=disable
FRAUD_KAFKA_BROKERS=redpanda:9092
FRAUD_MODEL_URL=http://model-server:8514
FRAUD_MODEL_BACKEND=bentoml
FRAUD_MODEL_MAX_INFLIGHT=1
FRAUD_MODEL_WORKERS=2
FRAUD_TRITON_URL=http://triton:8000
FRAUD_SHADOW_ENABLED=true
FRAUD_RULES_DIR=/app/rules
FRAUD_FEATURE_SPEC=/app/features/spec.yaml
FRAUD_SPOOL_DIR=/var/spool/fraud
FRAUD_JWKS_URL=http://dev-issuer:8515/.well-known/jwks.json
FRAUD_RATE_LIMIT_RPS=20
FRAUD_DEVICE_SALT=synthetic-dev-salt

# --- dev-issuer -----------------------------------------------------------
FRAUD_ISSUER=http://dev-issuer:8515
FRAUD_ISSUER_ADDR=:8515

# --- case-summarizer (Python) --------------------------------------------
FRAUD_SUMMARY_PROVIDER=fake
FRAUD_SUMMARY_MODEL=claude-haiku-5-5
FRAUD_SUMMARY_FALLBACK_PROVIDER=
FRAUD_OPENAI_MODEL=gpt-5-mini
FRAUD_SUMMARIZER_PG_DSN=postgresql://fraud_app:fraud_app@postgres:5432/fraud
DEMO_MODE=offline

# Provider keys: only for make eval-live / make record-fixtures, never needed offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LIVE_EVAL_BUDGET_USD=2

# --- training / registry --------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
FRAUD_MODEL_NAME=fraud-gbdt

# --- observability (profile observability / datadog) ----------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_API_KEY=
